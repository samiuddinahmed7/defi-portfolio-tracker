# External API Keys
# Get your Etherscan API key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Get your Alchemy API key at https://dashboard.alchemy.com/
ALCHEMY_API_KEY=

# Database connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/defi_tracker?sslmode=disable

# Ethereum RPC endpoint (used for Chainlink on-chain price feed reads)
# Can be your Alchemy endpoint: https://eth-mainnet.g.alchemy.com/v2/<your-key>
ETHEREUM_RPC_URL=

# Chainlink ETH/USD price feed contract address on Ethereum mainnet
CHAINLINK_ETH_USD_FEED=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419

# Additional Chainlink feeds (optional)
CHAINLINK_BTC_USD_FEED=0xF4030086522a5bEEa4988F8cA5B36dbC97BeE88d
CHAINLINK_LINK_USD_FEED=0x2c1d072e956AFFC0D435Cb7AC308d97936Ed4a3

# Server configuration
PORT=8080
LOG_LEVEL=info

# Demo mode: when true, uses fixture data instead of live API calls
# Useful for development and testing without API keys
DEMO_MODE=false

# Optional: request timeout in seconds for external API calls
PROVIDER_TIMEOUT_SECONDS=10
